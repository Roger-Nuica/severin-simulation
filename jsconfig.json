{
  "compilerOptions": {
    "paths": {
      "@/*": ["./src/*"]
    },
    "allowJs": true,
    "checkJs": false,
    "strict": false,
    "maxNodeModuleJsDepth": 0,
    "noEmit": true,
    "target": "es2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["es2022", "dom", "dom.iterable"],
    "skipLibCheck": true,
    "jsx": "preserve"
  },
  "include": ["types.d.ts", "src/**/*.js"],
  "exclude": ["node_modules", ".next"]
}
